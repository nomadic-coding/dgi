<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Currency Form View -->
    <record id="view_currency_form_dgi" model="ir.ui.view">
        <field name="name">res.currency.form.dgi</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dgi_code_id" groups="base.group_no_one,account.group_account_user"/>
            </field>
        </field>
    </record>
</odoo>

