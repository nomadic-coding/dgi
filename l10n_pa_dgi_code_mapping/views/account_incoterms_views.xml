<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Incoterms Form View -->
    <record id="view_incoterms_form_dgi" model="ir.ui.view">
        <field name="name">account.incoterms.form.dgi</field>
        <field name="model">account.incoterms</field>
        <field name="inherit_id" ref="account.account_incoterms_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="dgi_code_id" groups="base.group_no_one"/>
            </field>
        </field>
    </record>
</odoo>

