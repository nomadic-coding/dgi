<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View -->
    <record id="product_template_form_view_dgi" model="ir.ui.view">
        <field name="name">product.template.form.dgi</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="accounting" position="inside">
                <group string="Panama DGI" groups="base.group_no_one">
                    <field name="dgi_code_id"/>
                </group>
            </group>
        </field>
    </record>
</odoo>

