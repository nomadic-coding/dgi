#. module: l10n_pa_edi
#: model:ir.model.fields,field_description:l10n_pa_edi.field_account_journal__dgi_auto_send_on_post
msgid "Auto-Send to DGI on Confirm"
msgstr "Enviar automáticamente a DGI al confirmar"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/res_partner.py:0
msgid "Please enter a RUC number first"
msgstr "Primero ingrese un número de RUC"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/res_partner.py:0
msgid "Please select a valid Tipo RUC (01=Natural Person, 02=Juridical Person)"
msgstr "Seleccione un tipo de RUC válido (01=Persona natural, 02=Persona jurídica)"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "This document has already been sent to DGI"
msgstr "Este documento ya fue enviado a DGI"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Only posted invoices can be sent to DGI"
msgstr "Solo las facturas publicadas se pueden enviar a DGI"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "DGI Electronic Invoicing is not enabled for this journal"
msgstr "La facturación electrónica DGI no está habilitada en este diario"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/wizard/dgi_anulacion_wizard.py:0
msgid "This invoice has not been sent to DGI yet."
msgstr "Esta factura aún no ha sido enviada a DGI."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/wizard/dgi_anulacion_wizard.py:0
msgid "Please provide a cancellation reason."
msgstr "Indique el motivo de anulación."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/wizard/dgi_anulacion_wizard.py:0
msgid "Cancellation reason must be at least 20 characters long. Current length: %d characters."
msgstr "El motivo de anulación debe tener al menos 20 caracteres. Longitud actual: %d caracteres."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/wizard/dgi_anulacion_wizard.py:0
msgid "Cancellation reason must not exceed 500 characters. Current length: %d characters."
msgstr "El motivo de anulación no debe superar 500 caracteres. Longitud actual: %d caracteres."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/wizard/dgi_anulacion_wizard.py:0
msgid "Failed to cancel the invoice in DGI: %s. The invoice was not canceled in Odoo."
msgstr "No se pudo anular la factura en DGI: %s. La factura no se canceló en Odoo."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_tax.py:0
msgid "If HKA Tax Code is '04' (ISC), you must also set the HKA ISC rate."
msgstr "Si el código de impuesto HKA es '04' (ISC), también debe configurar la tasa ISC HKA."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Product DGI/CPBS code is required when the receiver is a government entity (%s)."
msgstr "El código DGI/CPBS del producto es obligatorio cuando el receptor es una entidad de gobierno (%s)."

#. module: l10n_pa_edi
#: model:ir.model.fields,field_description:l10n_pa_edi.field_account_move__hka_merge_same_dgi_code
#: model:ir.model.fields,field_description:l10n_pa_edi.field_res_company__hka_merge_same_dgi_code
#: model:ir.model.fields,field_description:l10n_pa_edi.field_res_config_settings__hka_merge_same_dgi_code
msgid "Sale Type"
msgstr "Tipo de venta"

#. module: l10n_pa_edi
#: model:ir.model.fields,field_description:l10n_pa_edi.field_account_move__hka_merge_same_dgi_code
#: model:ir.model.fields,field_description:l10n_pa_edi.field_res_company__hka_merge_same_dgi_code
#: model:ir.model.fields,field_description:l10n_pa_edi.field_res_config_settings__hka_merge_same_dgi_code
msgid "Merge Same DGI Code Lines"
msgstr "Combinar líneas con el mismo código DGI"

#. module: l10n_pa_edi
#: model:ir.model.fields,help:l10n_pa_edi.field_account_move__hka_merge_same_dgi_code
msgid "Group e-factura lines that share the same DGI product/service code (and the same ITBMS/ISC) into one line. Defaults from the company setting."
msgstr "Agrupa en una sola línea de e-factura las líneas que comparten el mismo código DGI de producto/servicio (y el mismo ITBMS/ISC). El valor inicial sale de la configuración de la compañía."

#. module: l10n_pa_edi
#: model:ir.model.fields,help:l10n_pa_edi.field_res_company__hka_merge_same_dgi_code
#: model:ir.model.fields,help:l10n_pa_edi.field_res_config_settings__hka_merge_same_dgi_code
msgid "Default for new invoices: group e-factura lines that share the same DGI product/service code (and the same ITBMS/ISC) into one line."
msgstr "Valor predeterminado para facturas nuevas: agrupa en una sola línea de e-factura las líneas que comparten el mismo código DGI de producto/servicio (y el mismo ITBMS/ISC)."

#. module: l10n_pa_edi
#: model_terms:ir.ui.view,arch_db:l10n_pa_edi.res_config_settings_view_form
msgid "E-Factura Lines"
msgstr "Líneas de e-factura"

#. module: l10n_pa_edi
#: model_terms:ir.ui.view,arch_db:l10n_pa_edi.res_config_settings_view_form
msgid "Default for new invoices: send one e-factura line per DGI product/service code (same ITBMS/ISC). Can be overridden on each invoice."
msgstr "Valor predeterminado para facturas nuevas: enviar una línea de e-factura por código DGI de producto/servicio (mismo ITBMS/ISC). Se puede cambiar en cada factura."

#. module: l10n_pa_edi
#: model:ir.model.fields,field_description:l10n_pa_edi.field_account_move__hka_desc_forma_pago
msgid "Payment Method Description"
msgstr "Descripción de la forma de pago"

#. module: l10n_pa_edi
#: model:ir.model.fields,field_description:l10n_pa_edi.field_account_move__hka_fecha_inicio_contingencia
msgid "Contingency Start"
msgstr "Inicio de contingencia"

#. module: l10n_pa_edi
#: model:ir.model.fields,field_description:l10n_pa_edi.field_account_move__hka_motivo_contingencia
msgid "Contingency Reason"
msgstr "Motivo de contingencia"

#. module: l10n_pa_edi
#: model_terms:ir.ui.view,arch_db:l10n_pa_edi.view_move_form_dgi
msgid "At least 15 characters"
msgstr "Al menos 15 caracteres"

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Document Type %(doc)s is not valid for this invoice and receiver."
msgstr "El tipo de documento %(doc)s no es válido para esta factura y este receptor."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Nature of Operation %(nature)s is not valid for Document Type %(doc)s."
msgstr "La naturaleza de la operación %(nature)s no es válida para el tipo de documento %(doc)s."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Destination %(dest)s is not valid for Document Type %(doc)s."
msgstr "El destino %(dest)s no es válido para el tipo de documento %(doc)s."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Operation Type %(op)s is not valid for Document Type %(doc)s."
msgstr "El tipo de operación %(op)s no es válido para el tipo de documento %(doc)s."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Sale Type is required for sales documents."
msgstr "El tipo de venta es obligatorio en documentos de venta."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Sale Type must be empty when the document is not a sale."
msgstr "El tipo de venta debe quedar vacío cuando el documento no es una venta."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "CAFE Delivery %(delivery)s is not valid for CAFE Format %(fmt)s."
msgstr "La entrega de CAFE %(delivery)s no es válida para el formato CAFE %(fmt)s."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Contingency Start is required when Emission Type is 02 or 04."
msgstr "El inicio de contingencia es obligatorio cuando el tipo de emisión es 02 o 04."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Contingency Reason must be at least %(min)s characters when Emission Type is 02 or 04."
msgstr "El motivo de contingencia debe tener al menos %(min)s caracteres cuando el tipo de emisión es 02 o 04."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/account_move.py:0
msgid "Payment Method Description is required when Payment Method is 99."
msgstr "La descripción de la forma de pago es obligatoria cuando la forma de pago es 99."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/res_partner.py:0
msgid "Foreign partners can only use Tipo RUC 04 (Foreign Entity)."
msgstr "Los contactos extranjeros solo pueden usar el tipo de RUC 04 (Entidad extranjera)."

#. module: l10n_pa_edi
#. odoo-python
#: code:addons/l10n_pa_edi/models/res_partner.py:0
msgid "Tipo RUC 04 (Foreign Entity) cannot be used for a Panama partner."
msgstr "El tipo de RUC 04 (Entidad extranjera) no se puede usar en un contacto de Panamá."
